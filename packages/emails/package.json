  },
  "dependencies": {
    "@better-giving/brand": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-email": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.9",
    "react-email": "6.9.5",
    "typescript": "catalog:"
  }
}
