{
  "name": "emails-preview",
  "private": true,
  "description": "React Email preview site for Better Giving templates",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "email dev --dir emails --port 3001",
    "build": "email build --dir emails",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsx --tsconfig ../../packages/emails/tsconfig.json --test scripts/npo-terms-notice.test.ts",
    "render:npo-terms-notice": "tsx --tsconfig ../../packages/emails/tsconfig.json scripts/render-npo-terms-notice.ts"
  },
  "dependencies": {
    "emails": "workspace:*"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-email": "6.9.5",
    "tsx": "4.23.1",
    "typescript": "catalog:"
  }
}
