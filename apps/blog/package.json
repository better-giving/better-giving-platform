{
  "name": "blog",
  "private": true,
  "scripts": {
    "build": "sanity build",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "schema": "DO_NOT_TRACK=1 sanity schema extract --enforce-required-fields",
    "typegen": "DO_NOT_TRACK=1 sanity typegen generate && cp ./queries.ts ../../packages/types/blog/queries.ts"
  },
  "dependencies": {
    "@sanity/vision": "6.1.0",
    "groq": "6.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanity": "6.1.0",
    "styled-components": "6.4.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18"
  }
}
