{
  "name": "platform",
  "sideEffects": false,
  "private": true,
  "type": "module",
  "scripts": {
    "start": "react-router-serve build/server/index.js",
    "build": "react-router build",
    "postbuild": "if [ -z \"$CI\" ]; then echo 'postbuild: skipping migrations (CI unset)'; elif [ \"$VERCEL_ENV\" = production ]; then node .server/pg/check-migrations.ts && echo 'postbuild: production migrates in smoke.yml once checks pass'; else pnpm run migrate && node .server/pg/seed-preview-campaign.ts; fi",
    "migrate": "node --env-file-if-exists=.env .server/pg/migrate.ts",
    "format": "biome check --write .",
    "format-unsafe": "biome check --write --unsafe src",
    "lint": "biome check .",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest --run --bail 1",
    "coverage": "vitest --run --coverage --bail 1"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@ai-sdk/valibot": "2.0.28",
    "@anvilco/anvil": "3.3.2",
    "@ark-ui/react": "5.37.2",
    "@better-auth/infra": "0.3.2",
    "@better-giving/brand": "workspace:*",
    "@better-giving/chariot": "workspace:*",
    "@better-giving/crypto": "workspace:*",
    "@better-giving/paypal": "workspace:*",
    "@better-giving/stocks": "workspace:*",
